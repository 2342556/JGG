# JGG configuration — copy to .env (never commit .env). No value below is required for Demo/Paper.
PORT=8787
JGG_ENV=development            # development | test (test enables x-jgg-test-fault header + relaxed rate limits)
JGG_ORIGIN=http://localhost:8787 # used for SIWS domain binding and cookie Secure flag (https → Secure)
JGG_DB=./data/jgg.db           # dev SQLite path (WAL). Production: PostgreSQL, see infra/postgres
JGG_WORKER_INTERVAL_MS=2000
# --- PostgreSQL (production contract; app connects as role jgg_app, NOBYPASSRLS) ---
DATABASE_URL=
# --- Standalone live data (JGG indexer, Solana pump.fun) — Option B, no GMGN needed ---
JGG_DATA_SOURCE=                 # set to solana_live to use the indexer (API + worker + indexer processes); empty = Demo fixtures
JGG_SOLANA_RPC_HTTP=             # any standard Solana RPC provider (HTTPS URL; keep provider keys out of git)
JGG_SOLANA_RPC_WS=               # matching WebSocket URL (must support logsSubscribe)
JGG_RPC_MAX_RPS=8                # client-side pacing for HTTP RPC calls
JGG_TX_FETCH_CONCURRENCY=2       # getTransaction fallback for emit_cpi-only events
JGG_JUPITER_API_KEY=             # free key at portal.jup.ag — SOL/USD via Price API v3
JGG_SOL_USD_MANUAL=              # optional manual SOL/USD if no Jupiter key (flagged as manual on /status)
# --- Optional third-party labels: fomoapi.io (independent API about fomo.family traders; NOT fomo.family) ---
JGG_FOMOAPI_KEY=                 # free key at fomoapi.io/dashboard; used only for wallet→handle labels
JGG_FOMO_POLL_MIN=60             # minutes between leaderboard pulls (250 credits each; free = 250k credits/month)
# --- LIVE TRADING WITH REAL FUNDS (off by default) ---
JGG_LIVE_TRADING=                # set to "enabled" only after reading docs/DEPLOY.md §Live trading
JGG_CUSTODY_MASTER_KEY=          # 32 random bytes, base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"  — BACK IT UP OFFLINE; losing it loses access to trading-wallet keys
JGG_LIVE_ALLOWED_WALLETS=        # comma-separated Solana addresses allowed to hold a trading wallet (your Phantom address)
JGG_LIVE_MAX_TRADE_SOL=0.05      # hard cap per live buy
JGG_LIVE_MAX_DAILY_SOL=0.5       # hard cap on live buys per 24h
JGG_TRUST_PROXY=                 # set to 1 when behind Netlify/Caddy so rate limits use the client IP
# --- Optional third-party market data (not required) ---
GMGN_API_KEY=                   # from https://gmgn.ai/ai ; read-only use by JGG (install: npm i -g gmgn-cli; IPv4 egress)
GMGN_CLI=                       # optional path to gmgn-cli
SOLANA_RPC_URL=
EVM_RPC_URL_BSC=
EVM_RPC_URL_BASE=
EVM_RPC_URL_ETHEREUM=
# --- Execution / signing (blocked; requires owner authorization for any funded test, T59) ---
JUPITER_API_BASE=
SIGNER_SERVICE_URL=
# --- Social / news ---
X_API_BEARER_TOKEN=
OPEN6551_API_KEY=
TELEGRAM_BOT_TOKEN=
WEB_PUSH_VAPID_PUBLIC=
WEB_PUSH_VAPID_PRIVATE=
# --- AI (optional; without it the rule-based planner is used and labeled) ---
ANTHROPIC_API_KEY=
